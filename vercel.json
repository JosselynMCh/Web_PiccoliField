{
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://piccolifield-api-smkc.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://piccolifield-api-smkc.onrender.com/uploads/:path*"
    }
  ]
}
